[Unit]
Description=RAFEEQ Camera Preview Server
After=network-online.target
Wants=network-online.target
Conflicts=rafeeq-camera.service

[Service]
Type=simple
User=bayan
WorkingDirectory=/opt/rafeeq
Environment=PYTHONUNBUFFERED=1
ExecStartPre=+/usr/bin/install -d -o bayan -g bayan -m 0775 /opt/rafeeq/.run
ExecStart=/opt/rafeeq/edge/robot/.venv/bin/python /opt/rafeeq/scripts/camera_preview_server.py --host 127.0.0.1 --port 8090 --camera-index 0
StandardOutput=append:/opt/rafeeq/.run/pi-camera.log
StandardError=append:/opt/rafeeq/.run/pi-camera.log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
