[Unit]
Description=RAFEEQ Camera Fall Detection Service
After=network-online.target rafeeq-backend.service rafeeq-robot.service
Wants=network-online.target rafeeq-backend.service rafeeq-robot.service

[Service]
Type=simple
User=rafeeq
WorkingDirectory=-/tmp/rafeeq-runtime
EnvironmentFile=/etc/rafeeq/robot.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=+/usr/bin/install -d -o rafeeq -g rafeeq -m 0775 /tmp/rafeeq-runtime
ExecStartPre=/bin/bash -lc 'set -a; . /etc/rafeeq/robot.env; set +a; for _ in $(seq 1 60); do /usr/bin/curl -fsS "${BACKEND_BASE_URL:-http://127.0.0.1:8000}/health/ready" >/dev/null 2>&1 && exit 0; sleep 1; done; echo "Backend health was not ready before camera start; continuing with local fall detection." >&2; exit 0'
ExecStart=/bin/bash -lc 'source /etc/rafeeq/robot.env; export RAFEEQ_CAMERA_READY_FILE="${RAFEEQ_CAMERA_READY_FILE:-/tmp/rafeeq-runtime/camera_ready}"; rm -f "$RAFEEQ_CAMERA_READY_FILE"; /opt/rafeeq/edge/robot/.venv/bin/rafeeq-fall-demo --camera-index "${CAMERA_INDEX:-0}" --detector motion --headless --speaker openai --voice-verification --verification-timeout "${FALL_VERIFICATION_TIMEOUT_SECONDS:-20}" --cooldown "${FALL_DETECTION_COOLDOWN_SECONDS:-60}" --warmup-seconds "${CAMERA_WARMUP_SECONDS:-10}" --stream-host "${CAMERA_STREAM_HOST:-127.0.0.1}" --stream-port "${CAMERA_STREAM_PORT:-8090}" & pid=$!; deadline=$((SECONDS + ${CAMERA_STARTUP_WATCHDOG_SECONDS:-180})); while kill -0 "$pid" 2>/dev/null; do if [ -f "$RAFEEQ_CAMERA_READY_FILE" ]; then wait "$pid"; exit $?; fi; if [ "$SECONDS" -ge "$deadline" ]; then echo "RAFEEQ camera did not become ready before startup watchdog; restarting." >&2; kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; exit 1; fi; sleep 1; done; wait "$pid"; exit $?'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
