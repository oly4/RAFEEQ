APP_ENV=development
APP_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://rafeeq:rafeeq@postgres:5432/rafeeq
REDIS_URL=redis://redis:6379/0
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://localhost:8443,https://127.0.0.1:8443
LOG_LEVEL=INFO
RAFEEQ_DEVICE_ID=
RAFEEQ_DEVICE_SECRET=
RAFEEQ_PATIENT_ID=
BACKEND_BASE_URL=http://localhost:8000
LOCAL_DATABASE_PATH=./data/robot.db
HARDWARE_MODE=simulation
SPEAKER_PROVIDER=console
SPEAKER_RATE=0
SPEAKER_VOLUME=100
PIPER_VOICE_MODEL=./.run/models/piper/ar_JO-kareem-medium/ar_JO-kareem-medium.onnx
PIPER_VOICE_CONFIG=./.run/models/piper/ar_JO-kareem-medium/ar_JO-kareem-medium.onnx.json
CAMERA_INDEX=0
FALL_VERIFICATION_TIMEOUT_SECONDS=20
FALL_DETECTION_COOLDOWN_SECONDS=60
SOS_BUTTON_ENABLED=true
SOS_BUTTON_GPIO=17
SOS_BUTTON_PULL_UP=true
SOS_BUTTON_BOUNCE_SECONDS=0.15
SOS_BUTTON_COOLDOWN_SECONDS=5
SOS_BUTTON_SHUTDOWN_ENABLED=true
SOS_BUTTON_SHUTDOWN_HOLD_SECONDS=3
SOS_BUTTON_SHUTDOWN_COMMAND='sudo -n /usr/bin/systemctl poweroff'
VOICE_INTERACTION_PROVIDER=simulation
VOSK_MODEL_PATH=./.run/models/vosk-ar
VOSK_INPUT_DEVICE=
VOSK_SAMPLE_RATE=16000
VOICE_LISTEN_SECONDS=6
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=off
OPENAI_TEXT_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=low
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
CAMERA_CONTROL_ENABLED=false
CAMERA_SERVICE_NAME=rafeeq-camera
NETWORK_CONTROL_ENABLED=false
NETWORK_CONTROL_ADMIN_PIN=
NETWORK_CONTROL_HELPER=/opt/rafeeq/scripts/rafeeq_network_control.py
RAFEEQ_VOICE_ACCESS_TOKEN=
RAFEEQ_VOICE_CAREGIVER_EMAIL=
RAFEEQ_VOICE_CAREGIVER_PASSWORD=
VOICE_MAX_SESSION_SECONDS=120
VOICE_REMINDER_SNOOZE_MINUTES=10
STARTUP_GREETING_ENABLED=true
VOICE_UPLOAD_AUDIO=false
VOICE_DEFAULT_LOCALE=en
API_BASE_URL=http://localhost:8000/api/v1
WS_BASE_URL=ws://localhost:8000
RAFEEQ_CAMERA_STREAM_URL=http://localhost:8090/stream.mjpg
RAFEEQ_CAMERA_CONTROL_BASE_URL=http://localhost:8000/api/v1
DEMO_CAREGIVER_PASSWORD=
